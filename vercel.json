{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/flappy-bird", "destination": "/index.html" },
    { "source": "/flappy-bird/(.*)", "destination": "/$1" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
